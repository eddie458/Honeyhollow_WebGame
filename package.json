{
  "name": "honeyhollow",
  "private": true,
  "version": "1.0.0",
  "description": "Honeyhollow - a free, browser-based social city-builder.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs",
    "serve:api": "php -S 127.0.0.1:8090 -t server server/dev-router.php",
    "test:api": "php server/tests/smoke_test.php http://127.0.0.1:8090/api/"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
