# Build files: every file name contains a hash of its content, so a changed
# file always gets a new name. That makes them safe to cache for a year.
Options -Indexes
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</IfModule>
